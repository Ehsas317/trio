<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.user.trio.rush</string>
    <key>ProgramArguments</key>
    <array>
        <string>{{VENV_PYTHON}}</string>
        <string>{{RUSH_SCRIPT}}</string>
    </array>
    <key>WorkingDirectory</key>
    <string>{{RUSH_DIR}}</string>
    <key>StandardOutPath</key>
    <string>{{LOG_DIR}}/rush/rush_stdout.log</string>
    <key>StandardErrorPath</key>
    <string>{{LOG_DIR}}/rush/rush_stderr.log</string>
    <key>KeepAlive</key>
    <true/>
    <key>RunAtLoad</key>
    <true/>
</dict>
</plist>